# Copy this file to ".env" and fill in your key.
# Get a FREE key at https://openrouter.ai/keys (no credit card needed)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# "openrouter/free" auto-picks any available free model.
# Or pin one, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free

DB_PATH=chat.db
